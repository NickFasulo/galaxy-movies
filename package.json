{
  "name": "top-stuff",
  "version": "0.1.0",
  "private": false,
  "scripts": {
    "dev": "npx kill-port 3000 && next dev --webpack",
    "dev:turbo": "npx kill-port 3000 && next dev",
    "build": "next build",
    "prestart": "npx kill-port 3000",
    "start": "next start",
    "check": "npm run typecheck && npm run build",
    "lint": "eslint .",
    "lhci": "npm run build && lhci autorun --config=./lighthouserc.cjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "postinstall": "patch-package",
    "cf:build": "next build --webpack && node scripts/fix-standalone-trace.js && opennextjs-cloudflare build --skipNextBuild && node scripts/opennext-postbuild.js",
    "cf:preview": "npm run cf:build && wrangler dev",
    "cf:deploy": "npm run cf:build && wrangler deploy",
    "cf:secrets": "node scripts/sync-cf-secrets.js && wrangler secret bulk .secrets.json",
    "test:coverage": "vitest run --coverage",
    "prepare": "husky",
    "smoke": "bash scripts/smoke.sh",
    "smoke:workerd": "bash scripts/workerd-smoke.sh",
    "index:check": "node scripts/check-upcoming-indexing.js"
  },
  "dependencies": {
    "@chakra-ui/react": "^3.37.0",
    "@tanstack/react-query": "^5.105.0",
    "@upstash/redis": "1.40.0",
    "framer-motion": "^14.6.0",
    "lru-cache": "^11.5.2",
    "next": "^16.4.3",
    "next-themes": "^0.4.6",
    "openai": "^7.45.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-icons": "^5.7.0",
    "react-infinite-scroll-component": "^7.2.1",
    "react-player": "^3.4.0",
    "react-server-dom-webpack": "^19.3.1",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@lhci/cli": "^0.15.1",
    "@next/bundle-analyzer": "^16.4.3",
    "@opennextjs/cloudflare": "^1.20.13",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.0.5",
    "esbuild": "^0.28.2",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "husky": "^9.1.7",
    "kill-port": "^2.0.1",
    "patch-package": "^8.0.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.3",
    "wrangler": "^4.153.0"
  },
  "overrides": {
    "tar": "^7.4.3",
    "adm-zip": "^0.5.10",
    "postcss": "^8.5.23",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "@puppeteer/browsers": "^3.2.2",
    "fflate": "0.8.3",
    "basic-ftp": "^6.2.2",
    "@lhci/utils": {
      "js-yaml": "^4.1.0"
    },
    "@node-minify/core": {
      "glob": "10.5.0"
    },
    "@dotenvx/dotenvx": {
      "undici": "^7.30.1"
    },
    "chromium-bidi": {
      "zod": "^4.6.7"
    },
    "openai": {
      "zod": "^4.6.7"
    }
  },
  "allowScripts": {
    "unrs-resolver@1.12.2": true,
    "workerd@1.20261023.1": true,
    "esbuild": false
  }
}
