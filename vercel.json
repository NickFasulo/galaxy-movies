{
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "crons": [
    {
      "path": "/api/cron/generate-content",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/streaming-changes",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/watchlist-alerts",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 16 * * 5"
    }
  ]
}
