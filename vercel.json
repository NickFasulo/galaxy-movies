{
  "git": {
    "deploymentEnabled": {
      "main": false
    }
  },
  "ignoreCommand": "git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':!*.md' ':!.github' ':!scripts' ':!.devin' ':!lighthouserc.cjs'",
  "crons": [
    {
      "path": "/api/cron/generate-content",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/streaming-changes",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/cron/watchlist-alerts",
      "schedule": "0 7 * * *"
    },
    {
      "path": "/api/cron/weekly-digest",
      "schedule": "0 16 * * 5"
    },
    {
      "path": "/api/cron/social-broadcast",
      "schedule": "30 15 * * 1"
    },
    {
      "path": "/api/cron/social-monthly",
      "schedule": "0 17 25 * *"
    }
  ]
}
